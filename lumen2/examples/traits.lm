// Traits: a user trait with impls, a user Ord that replaces structural
// ordering everywhere, and Show, which is derived for every type without
// functions in it. Run `lumen2 check` to see the constraints in the types.

trait Area { fn area(x: Self) -> Int }

type Shape { Square(Int), Rect(Int, Int), Circle(Int) }
impl Area for Shape {
  fn area(s) { match s { Square(n) -> n * n, Rect(w, h) -> w * h, Circle(r) -> 3 * r * r } }
}
// A list of things with an area has the sum of their areas.
impl Area for List<a> where a: Area { fn area(xs) { sum(map(xs, area)) } }

// Versions sort newest first, wherever they are compared.
type Version { V(Int, Int) }
impl Ord for Version {
  fn compare(a, b) { match (a, b) { (V(x1, y1), V(x2, y2)) -> if x1 != x2 { x2 - x1 } else { y2 - y1 } } }
}

fn describe(x) { show(x) ++ " has area " ++ show(area(x)) }

fn main() {
  println(describe([Square(2), Rect(1, 3)]));
  println(describe([[Circle(1)], [Square(3), Square(4)]]));
  println(show(sort([V(1, 2), V(3, 0), V(1, 5)])));
  println(show([Some(V(1, 0))] < [Some(V(0, 9))]));
  println(show((1, "two", [true], names())))
}

fn names() { array_from_list(["ada", "grace"]) }
