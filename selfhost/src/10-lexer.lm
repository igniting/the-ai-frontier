// ================================================================== lexer ==
// Port of src/lexer.js. Source text is a byte string, so offsets are byte
// offsets. Errors abort with panic("@start-end phase: message").

type Tok { Tok(String, String, Int, Int, Int) } // kind, text, int value, start, end

fn tok_kind(t) { match t { Tok(k, _, _, _, _) -> k } }
fn tok_text(t) { match t { Tok(_, x, _, _, _) -> x } }
fn tok_int(t) { match t { Tok(_, _, n, _, _) -> n } }
fn tok_start(t) { match t { Tok(_, _, _, s, _) -> s } }
fn tok_end(t) { match t { Tok(_, _, _, _, e) -> e } }

fn fail_at(s, e, phase, msg) { panic("@" ++ int_to_string(s) ++ "-" ++ int_to_string(e) ++ " " ++ phase ++ ": " ++ msg) }

fn is_keyword(w) {
  match w {
    "fn" -> true, "let" -> true, "if" -> true, "else" -> true, "match" -> true,
    "type" -> true, "true" -> true, "false" -> true, _ -> false,
  }
}

fn is_op2(s) {
  match s {
    "|>" -> true, "->" -> true, "=>" -> true, "==" -> true, "!=" -> true, "<=" -> true,
    ">=" -> true, "&&" -> true, "||" -> true, "++" -> true, ".." -> true, _ -> false,
  }
}

fn is_op1(s) { string_length(s) == 1 && contains(chars("(){}[],;:<>+-*/%!=|"), s) }

fn lex(src) {
  let n = string_length(src);
  let at = |i| if i < n { char_code_at(src, i) } else { -1 };

  fn skip_line(i) { if i < n && at(i) != 10 { skip_line(i + 1) } else { i } }

  fn skip_block(start, i, depth) {
    if at(i) == 47 && at(i + 1) == 42 { skip_block(start, i + 2, depth + 1) }
    else if at(i) == 42 && at(i + 1) == 47 { if depth == 1 { i + 2 } else { skip_block(start, i + 2, depth - 1) } }
    else if i >= n { fail_at(start, start + 2, "syntax", "unterminated block comment") }
    else { skip_block(start, i + 1, depth) }
  }

  // Digits accumulate as a negative magnitude, so 2^30 (valid after unary
  // minus) is representable; the parser negates.
  fn number(s, i, neg) {
    let c = at(i);
    if is_digit_code(c) {
      let d = c - 48;
      if neg < -107374182 || neg * 10 - d < -1073741824 {
        fail_at(s, i + 1, "syntax", "integer literal " ++ substring(src, s, i + 1) ++ "... does not fit in 31 bits")
      } else { number(s, i + 1, neg * 10 - d) }
    } else if c == 95 { number(s, i + 1, neg) }
    else if is_alpha_code(c) { fail_at(i, i + 1, "syntax", "invalid character in number literal") }
    else { (Tok("int", substring(src, s, i), neg, s, i), i) }
  }

  fn ident_end(i) { if is_alpha_code(at(i)) || is_digit_code(at(i)) { ident_end(i + 1) } else { i } }

  fn hex(c) { if is_digit_code(c) { c - 48 } else if c >= 97 && c <= 102 { c - 87 } else if c >= 65 && c <= 70 { c - 55 } else { -1 } }

  fn string_lit(s, i, pieces, chunk_start) {
    let flush = || [substring(src, chunk_start, i), ..pieces];
    let c = at(i);
    if c == -1 || c == 10 { fail_at(s, i, "syntax", "unterminated string literal") }
    else if c == 34 { (Tok("str", join(reverse(flush()), ""), 0, s, i + 1), i + 1) }
    else if c == 92 {
      let e = at(i + 1);
      let simple = if e == 110 { 10 } else if e == 116 { 9 } else if e == 114 { 13 } else if e == 92 { 92 }
        else if e == 34 { 34 } else if e == 39 { 39 } else if e == 48 { 0 } else { -1 };
      if simple >= 0 { string_lit(s, i + 2, [char_from_code(simple), ..flush()], i + 2) }
      else if e == 120 && hex(at(i + 2)) >= 0 && hex(at(i + 3)) >= 0 {
        string_lit(s, i + 4, [char_from_code(hex(at(i + 2)) * 16 + hex(at(i + 3))), ..flush()], i + 4)
      } else {
        fail_at(i, i + 2, "syntax", "unknown escape sequence \\" ++ if e == -1 { "" } else { char_from_code(e) })
      }
    } else { string_lit(s, i + 1, pieces, chunk_start) }
  }

  fn go(i, acc) {
    if i >= n { reverse([Tok("eof", "", 0, n, n), ..acc]) }
    else {
      let c = at(i);
      if c == 32 || c == 9 || c == 13 || c == 10 { go(i + 1, acc) }
      else if c == 47 && at(i + 1) == 47 { go(skip_line(i), acc) }
      else if c == 47 && at(i + 1) == 42 { go(skip_block(i, i, 0), acc) }
      else if is_digit_code(c) {
        let (tok, j) = number(i, i, 0);
        go(j, [tok, ..acc])
      } else if is_alpha_code(c) {
        let j = ident_end(i);
        let word = substring(src, i, j);
        let kind = if is_keyword(word) { word } else if is_upper_code(c) { "uid" } else { "lid" };
        go(j, [Tok(kind, word, 0, i, j), ..acc])
      } else if c == 34 {
        let (tok, j) = string_lit(i, i + 1, [], i + 1);
        go(j, [tok, ..acc])
      } else {
        let two = substring(src, i, i + 2);
        let one = substring(src, i, i + 1);
        if is_op2(two) { go(i + 2, [Tok(two, two, 0, i, i + 2), ..acc]) }
        else if is_op1(one) { go(i + 1, [Tok(one, one, 0, i, i + 1), ..acc]) }
        else { fail_at(i, i + 1, "syntax", "unexpected character '" ++ one ++ "'") }
      }
    }
  }
  go(0, [])
}
