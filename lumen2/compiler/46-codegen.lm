    wlen(gx, "s"), wop("i64.extend_i32_u"), wset("n"),
    wget("a"), wi64(0), wop("i64.lt_s"), wif(), wi64(0), wset("a"), wend(),
    wget("a"), wget("n"), wop("i64.gt_s"), wif(), wget("n"), wset("a"), wend(),
    wget("b"), wget("a"), wop("i64.lt_s"), wif(), wget("a"), wset("b"), wend(),
    wget("b"), wget("n"), wop("i64.gt_s"), wif(), wget("n"), if mutant == "substring-end" { CL([wi64(1), wop("i64.sub")]) } else { wnone() }, wset("b"), wend(),
    wget("b"), wget("a"), wop("i64.sub"), wop("i32.wrap_i64"), wcall("str_new"), wset("p"),
    wget("p"), wi32(8), wop("i32.add"), wget("s"), wi32(8), wop("i32.add"), wget("a"), wop("i32.wrap_i64"), wop("i32.add"),
    wget("b"), wget("a"), wop("i64.sub"), wop("i32.wrap_i64"), wop("memory.copy"),
    wget("p"),
  ]))
}
