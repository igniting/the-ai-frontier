// ===================================================================== main
// Input: a first line naming what to do, then the program.

fn split_commas(s) {
  fn go(i, start, acc) {
    if i >= string_length(s) { reverse([substring(s, start, i), ..acc]) }
    else if char_code_at(s, i) == 44 { go(i + 1, i + 1, [substring(s, start, i), ..acc]) }
    else { go(i + 1, start, acc) }
  }
  go(0, 0, [])
}

// The mode line: a word, then options `key=value` separated by spaces.
fn split_spaces(s) {
  fn go(i, start, acc) {
    if i >= string_length(s) { filter(reverse([substring(s, start, i), ..acc]), |w| w != "") }
    else if char_code_at(s, i) == 32 { go(i + 1, i + 1, [substring(s, start, i), ..acc]) }
    else { go(i + 1, start, acc) }
  }
  go(0, 0, [])
}
fn option(words, key) {
  match find(words, |w| starts_at(w, 0, key ++ "=")) { Some(w) -> Some(substring(w, string_length(key) + 1, string_length(w))), None -> None }
}

fn split_lines(s) {
  fn go(i, start, acc) {
    if i >= string_length(s) { reverse([substring(s, start, i), ..acc]) }
    else if char_code_at(s, i) == 10 { go(i + 1, i + 1, [substring(s, start, i), ..acc]) }
    else { go(i + 1, start, acc) }
  }
  go(0, 0, [])
}
fn int_of_dec(s) { match b_from_dec(s) { BS(v) -> v, _ -> 0 } }
fn f_show(f) { match f { F(m, e) -> int_to_string(m) ++ " " ++ int_to_string(e) } }
fn numtest(w) {
  let a = |i| list_get(w, i);
  let op = a(0);
  if op == "fadd" { f_show(f_add(F(int_of_dec(a(1)), int_of_dec(a(2))), F(int_of_dec(a(3)), int_of_dec(a(4))))) }
  else if op == "fmul" { f_show(f_mul(F(int_of_dec(a(1)), int_of_dec(a(2))), F(int_of_dec(a(3)), int_of_dec(a(4))))) }
  else if op == "fgt" { if f_gt(F(int_of_dec(a(1)), int_of_dec(a(2))), F(int_of_dec(a(3)), int_of_dec(a(4)))) { "true" } else { "false" } }
  else if op == "badd" { b_to_string(b_add(b_from_dec(a(1)), b_from_dec(a(2)))) }
  else if op == "bsub" { b_to_string(b_sub(b_from_dec(a(1)), b_from_dec(a(2)))) }
  else if op == "bmul" { b_to_string(b_mul(b_from_dec(a(1)), b_from_dec(a(2)))) }
  else if op == "bquot" { b_to_string(b_quot(b_from_dec(a(1)), b_from_dec(a(2)))) }
  else if op == "brem" { b_to_string(b_rem(b_from_dec(a(1)), b_from_dec(a(2)))) }
  else if op == "bcmp" { int_to_string(b_cmp(b_from_dec(a(1)), b_from_dec(a(2)))) }
  else if op == "buint" { b_to_string(b_as_uint(int_of_dec(a(1)), b_from_dec(a(2)))) }
  else if op == "bbits" { int_to_string(b_bit_length(b_from_dec(a(1)))) }
  else if op == "bbit" { int_to_string(b_bit(b_from_dec(a(1)), int_of_dec(a(2)))) }
  else { "?" }
}

fn main() {
  let input = read_input();
  fn line_end(i) { if i >= string_length(input) || char_code_at(input, i) == 10 { i } else { line_end(i + 1) } }
  let nl = line_end(0);
  let words = split_spaces(substring(input, 0, nl));
  let mode = match words { [w, .._] -> w, [] -> "" };
  let src = substring(input, nl + 1, string_length(input));
  let grants = match option(words, "grants") { Some(g) -> Some(filter(split_commas(g), |x| x != "")), None -> None };
  let entry = match option(words, "entry") { Some(e) -> e, None -> "main" };
  if mode == "ast" { let (ast, _) = parse(src, 0); println(d_ast(ast)) }
  else if mode == "check1" {
    match check_once(src, Opts(grants, entry, true, MEmpty, MEmpty)) {
      Checked(_, _, _, _, _, _, _, sigs, warns, _) -> {
        each(sigs, |s| match s { (n, t, _, _) -> println("sig " ++ n ++ ": " ++ t) });
        each(warns, |w| match w { (m, s, e) -> println("warn " ++ m ++ " @" ++ int_to_string(s) ++ "-" ++ int_to_string(e)) })
      },
    }
  }
  else if mode == "check" {
    let mutant = match option(words, "mutant") { Some(m) -> m, None -> "" };
    match check(src, grants, entry, mutant, false) {
      (Checked(_, _, _, _, _, _, _, sigs, warns, _), Verified(safe, un, obs)) -> {
        each(sigs, |s| match s { (n, t, _, _) -> println("sig " ++ n ++ ": " ++ t) });
        each(warns, |w| match w { (m, s, e) -> println("warn " ++ m ++ " @" ++ int_to_string(s) ++ "-" ++ int_to_string(e)) });
        each(sort(map(m_entries(safe), |e| match e { (k, _) -> k })), |k| println("safe " ++ k));
        each(sort(map(un, |e| match e { (k, n) -> k ++ ": " ++ n })), |x| println("unproved " ++ x));
        each(filter(obs, |o| match o { Oblig(_, sc, _, _, _, _, _, _, _, _, _, _, _) -> sc == "user" }), |o| match o {
          Oblig(kind, _, site, s, e, what, status, lemmas, clauses, ce, _, _, _) ->
            println("ob " ++ kind ++ " " ++ site ++ " @" ++ int_to_string(s) ++ "-" ++ int_to_string(e) ++ " " ++ what ++ " " ++ status ++ " " ++ int_to_string(lemmas) ++ " " ++ int_to_string(clauses) ++ " " ++ ce),
        })
      },
    }
  }
  else if mode == "lower1" || mode == "opt1" || mode == "rc1" || mode == "cert1" {
    let mutant = match option(words, "mutant") { Some(m) -> m, None -> "" };
    let flag = |f| contains_str(words, f);
    let checked = check_once(src, Opts(grants, entry, true, MEmpty, MEmpty));
    match checked {
      Checked(d, _, _, _, None, _, _, _, _, _) -> println("NOMAIN"),
      Checked(d, _, _, _, _, _, _, _, _, _) -> {
        let ir = lower_program(checked, mutant);
        let ir = if mode == "opt1" && !flag("noinline") { match ir { IRProg(fns, main, ords) -> IRProg(map(inline_small(fns, main), simplify), main, ords) } } else { ir };
        let o = BOpts(!flag("noinline"), !flag("noborrow"), !flag("noreuse"), !flag("nospec"), mutant);
        if mode == "cert1" {
          match ir { IRProg(fns, main, ords) -> {
            let fns = if !flag("noinline") { map(inline_small(fns, main), simplify) } else { fns };
            let (tf, ti) = check_types(d_adts(d), fns);
            match rc_program(d_adts(d), IRProg(fns, main, ords), BOpts(false, !flag("noborrow"), !flag("noreuse"), !flag("nospec"), mutant)) {
              IRProg(fns2, _, _) -> match check_ownership(d_adts(d), fns2) {
                OStats(a, b, c, e, g) -> {
                  println("types " ++ int_to_string(tf) ++ " " ++ int_to_string(ti));
                  println("ownership " ++ join(map([a, b, c, e, g], int_to_string), " "))
                },
              },
            }
          } }
        } else {
          let ir = if mode == "rc1" { rc_program(d_adts(d), ir, o) } else { ir };
          println(d_ir(ir, mode == "rc1"))
        }
      },
    }
  }
  else if mode == "wasm1" {
    let flag = |f| contains_str(words, f);
    let mutant = match option(words, "mutant") { Some(m) -> m, None -> "" };
    let checked = check_once(src, Opts(grants, entry, true, MEmpty, MEmpty));
    match checked {
      Checked(_, _, _, _, None, _, _, _, _, _) -> println("NOMAIN"),
      _ -> match back_end(checked, CgOpts(!flag("noinline"), !flag("noborrow"), !flag("noreuse"), !flag("nospec"), !flag("nosuperopt"), flag("paranoid"), mutant)) {
        Compiled(bytes, (tf, ti), OStats(a, b, c, e, g), stats, _, _) -> {
          println("types " ++ int_to_string(tf) ++ " " ++ int_to_string(ti));
          println("ownership " ++ join(map([a, b, c, e, g], int_to_string), " "));
          println("rewrites " ++ join(map(om_keys(stats), |k| k ++ ":" ++ int_to_string(match om_get(stats, k) { Some(n) -> n, None -> 0 })), " "));
          print("bytes ");
          hex_bytes(bytes);
          println("")
        },
      },
    }
  }
  else if mode == "numtest" { each(filter(split_lines(src), |l| l != ""), |l| println(numtest(split_spaces(l)))) }
  else { panic("unknown mode " ++ mode) }
}
