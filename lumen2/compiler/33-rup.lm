// ===================================================================== RUP
// An independent checker for DRUP refutations (rup.js): each lemma must
// follow from the formula and the lemmas before it by reverse unit
// propagation, and the empty clause must be reached. It shares no code with
// the solver. What unit propagation derives at the top level is kept.

type RupResult { RupOk(Int), RupBad(String) }

// vals (by variable), trail, clauses, watch lists and their lengths,
// counters (0 top, 1 base, 2 head, 3 refuted?)
type Rup { Rup(Array<Int>, Array<Int>, Array<Array<Int>>, Array<Array<Int>>, Array<Int>, Array<Int>) }

fn r_slot(l) { if l > 0 { 2 * l } else { 0 - 2 * l + 1 } }
fn r_abs(l) { if l < 0 { 0 - l } else { l } }
fn r_value(r, l) { match r { Rup(vals, _, _, _, _, _) -> { let v = array_get(vals, r_abs(l)); if l > 0 { v } else { 0 - v } } } }
fn r_int(r, i) { match r { Rup(_, _, _, _, _, ints) -> array_get(ints, i) } }
fn r_set_int(r, i, v) { match r { Rup(a, b, c, d, e, ints) -> Rup(a, b, c, d, e, array_set(ints, i, v)) } }
fn r_trail(r, i) { match r { Rup(_, t, _, _, _, _) -> array_get(t, i) } }

fn r_make(r, l) {
  let v = r_value(r, l);
  if v == 0 - 1 { (false, r) }
  else if v == 0 {
    match r { Rup(vals, t, db, ws, wl, ints) -> {
      let top = array_get(ints, 0);
      (true, Rup(array_set(vals, r_abs(l), if l > 0 { 1 } else { 0 - 1 }), array_set(t, top, l), db, ws, wl, array_set(ints, 0, top + 1)))
    } }
  } else { (true, r) }
}
fn r_take_watch(r, w) { match r { Rup(a, b, c, ws, wl, f) -> { let list = array_get(ws, w); (list, array_get(wl, w), Rup(a, b, c, array_set(ws, w, array_empty()), wl, f)) } } }
fn r_put_watch(r, w, list, len) { match r { Rup(a, b, c, ws, wl, f) -> Rup(a, b, c, array_set(ws, w, list), array_set(wl, w, len), f) } }
fn r_watch_push(r, w, x) { let (list, len, r) = r_take_watch(r, w); r_put_watch(r, w, push_at(list, len, x), len + 1) }
fn r_take_clause(r, ci) { match r { Rup(a, b, db, d, e, f) -> { let c = array_get(db, ci); (c, Rup(a, b, array_set(db, ci, array_empty()), d, e, f)) } } }
fn r_put_clause(r, ci, c) { match r { Rup(a, b, db, d, e, f) -> Rup(a, b, array_set(db, ci, c), d, e, f) } }

// Propagates from position `head`; true on a conflict.
fn r_propagate(r) {
  let head = r_int(r, 2);
  if head >= r_int(r, 0) { (false, r) }
  else {
    let f = 0 - r_trail(r, head);
    let r = r_set_int(r, 2, head + 1);
    let w = r_slot(f);
    let (ws, len, r) = r_take_watch(r, w);
    // Visits ws[i..len); a moved clause is replaced by the last one.
    fn visit(r, ws, i, len) {
      if i >= len { (false, r, ws, len) }
      else {
        let ci = array_get(ws, i);
        let (c0, r) = r_take_clause(r, ci);
        let c = if array_get(c0, 0) == f { array_set(array_set(c0, 0, array_get(c0, 1)), 1, f) } else { c0 };
        if r_value(r, array_get(c, 0)) == 1 { visit(r_put_clause(r, ci, c), ws, i + 1, len) }
        else {
          fn find_k(k) { if k >= array_length(c) { 0 - 1 } else if r_value(r, array_get(c, k)) != 0 - 1 { k } else { find_k(k + 1) } }
          let k = find_k(2);
          if k >= 0 {
            let x = array_get(c, k);
            let c2 = array_set(array_set(c, 1, x), k, f);
            let r = r_watch_push(r_put_clause(r, ci, c2), r_slot(x), ci);
            visit(r, array_set(ws, i, array_get(ws, len - 1)), i, len - 1)
          } else {
            let r = r_put_clause(r, ci, c);
            if r_value(r, array_get(c, 0)) == 0 - 1 { (true, r, ws, len) }
            else { let (_, r) = r_make(r, array_get(c, 0)); visit(r, ws, i + 1, len) }
          }
        }
      }
    }
    let (conflict, r, ws, len2) = visit(r, ws, 0, len);
    let r = r_put_watch(r, w, ws, len2);
    if conflict { (true, r) } else { r_propagate(r) }
  }
}
fn r_undo_to(r, n) {
  fn go(r) {
    let top = r_int(r, 0);
    if top > n {
      let l = r_trail(r, top - 1);
      match r { Rup(vals, t, db, ws, wl, ints) -> go(Rup(array_set(vals, r_abs(l), 0), t, db, ws, wl, array_set(ints, 0, top - 1))) }
    } else { r }
  }
  r_set_int(go(r), 2, n)
}

// Adds a clause at the top level (see rup.js).
fn r_add(r, c) {
  let lits0 = uniq_ints(c);
  if any(lits0, |l| any(lits0, |m| m == 0 - l)) { r }
  else {
    let lits = append(filter(lits0, |l| r_value(r, l) != 0 - 1), filter(lits0, |l| r_value(r, l) == 0 - 1));
    let open = length(filter(lits0, |l| r_value(r, l) != 0 - 1));
    let r = if length(lits) >= 2 {
      match r { Rup(a, b, db, d, e, f) -> {
        let ci = array_length(db);
        let r = Rup(a, b, array_push(db, array_from_list(lits)), d, e, f);
        r_watch_push(r_watch_push(r, r_slot(list_get(lits, 0)), ci), r_slot(list_get(lits, 1)), ci)
      } }
    } else { r };
    if open == 0 { r_set_int(r, 3, 1) }
    else if open == 1 && r_value(r, list_get(lits, 0)) == 0 {
      let (_, r) = r_make(r, list_get(lits, 0));
      let (conflict, r) = r_propagate(r);
      let r = if conflict { r_set_int(r, 3, 1) } else { r };
      r_set_int(r, 1, r_int(r, 0))
    } else { r }
  }
}

fn check_refutation(nvars, clauses, proof, mutant) {
  if mutant == "rup-accept-all" { RupOk(length(proof)) } else {
    let r0 = Rup(array_make(nvars + 1, 0), array_make(nvars + 1, 0), array_empty(), array_make(2 * nvars + 2, array_empty()), array_make(2 * nvars + 2, 0), array_make(4, 0));
    fn load(r, cs) {
      match cs {
        [] -> Some(r),
        [c, ..rest] -> if is_empty(c) { None } else { let r = r_add(r, c); if r_int(r, 3) == 1 { None } else { load(r, rest) } },
      }
    }
    match load(r0, clauses) {
      None -> RupOk(0),
      Some(r) -> {
        fn lemmas(r, ls, i) {
          match ls {
            [] -> RupBad("the proof does not derive the empty clause"),
            [lemma, ..rest] -> {
              if any(lemma, |l| l == 0 || r_abs(l) > nvars) { RupBad("lemma " ++ int_to_string(i + 1) ++ " mentions an unknown variable") }
              else {
                fn assume(r, xs) { match xs { [] -> (false, r), [l, ..more] -> { let (ok, r) = r_make(r, 0 - l); if !ok { (true, r) } else { assume(r, more) } } } }
                let (c1, r) = assume(r, lemma);
                let (conflict, r) = if c1 { (true, r) } else { r_propagate(r) };
                let r = r_undo_to(r, r_int(r, 1));
                if !conflict { RupBad("lemma " ++ int_to_string(i + 1) ++ " does not follow by unit propagation") }
                else if is_empty(lemma) { RupOk(i + 1) }
                else { let r = r_add(r, lemma); if r_int(r, 3) == 1 { RupOk(i + 1) } else { lemmas(r, rest, i + 1) } }
              }
            },
          }
        }
        lemmas(r, proof, 0)
      },
    }
  }
}
