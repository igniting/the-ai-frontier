{
  "name": "lumen",
  "version": "1.0.0",
  "description": "A statically typed functional language that compiles to WebAssembly, built from scratch with zero dependencies.",
  "type": "module",
  "bin": {
    "lumen": "bin/lumen.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "fuzz": "node fuzz/fuzz.js --count 2000",
    "mutants": "node fuzz/mutants.js --budget 400",
    "serve": "node bin/serve.js",
    "score": "node challenge/score.js -- node bin/lumen.js run"
  }
}
