// ===================================================================== SAT
// A CDCL SAT solver that writes a DRUP proof (sat.js): two watched literals,
// first-UIP learning, VSIDS with a binary heap (activities as doubles),
// phase saving and Luby restarts. Learned clauses are never deleted.
// Internal literals: 2v for v, 2v + 1 for -v.

type SatResult { SUnsat(List<List<Int>>), SSat(Array<Int>), SUnknown }

// vals, levels, reasons, phases, activities, seen, trail, decision-level
// starts, the clause arena (every clause's literals, one after another) and
// each clause's start in it (with the arena's length at the end), watch
// lists and their lengths, heap, heap positions, counters (0 trail length,
// 1 next to propagate, 2 decision level, 3 heap size, 4 n), activity
// increment, proof (newest first)
type Sat { Sat(Array<Int>, Array<Int>, Array<Int>, Array<Int>, Array<F>, Array<Int>, Array<Int>, Array<Int>, Array<Int>, Array<Int>, Array<Array<Int>>, Array<Int>, Array<Int>, Array<Int>, Array<Int>, F, List<List<Int>>) }

fn lit_flip(l) { if l % 2 == 0 { l + 1 } else { l - 1 } }
fn lit_enc(d) { if d > 0 { 2 * d } else { 0 - 2 * d + 1 } }
fn lit_dec(l) { if l % 2 == 1 { 0 - l / 2 } else { l / 2 } }

fn s_val(s, i) { match s { Sat(x, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> array_get(x, i) } }
fn s_set_val(s, i, v) { match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> Sat(array_set(f0, i, v), f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) } }
fn s_level(s, i) { match s { Sat(_, x, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> array_get(x, i) } }
fn s_set_level(s, i, v) { match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> Sat(f0, array_set(f1, i, v), f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) } }
fn s_reason(s, i) { match s { Sat(_, _, x, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> array_get(x, i) } }
fn s_set_reason(s, i, v) { match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> Sat(f0, f1, array_set(f2, i, v), f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) } }
fn s_phase(s, i) { match s { Sat(_, _, _, x, _, _, _, _, _, _, _, _, _, _, _, _, _) -> array_get(x, i) } }
fn s_set_phase(s, i, v) { match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> Sat(f0, f1, f2, array_set(f3, i, v), f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) } }
fn s_act(s, i) { match s { Sat(_, _, _, _, x, _, _, _, _, _, _, _, _, _, _, _, _) -> array_get(x, i) } }
fn s_set_act(s, i, v) { match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> Sat(f0, f1, f2, f3, array_set(f4, i, v), f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) } }
fn s_seen(s, i) { match s { Sat(_, _, _, _, _, x, _, _, _, _, _, _, _, _, _, _, _) -> array_get(x, i) } }
fn s_set_seen(s, i, v) { match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> Sat(f0, f1, f2, f3, f4, array_set(f5, i, v), f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) } }
fn s_trail(s, i) { match s { Sat(_, _, _, _, _, _, x, _, _, _, _, _, _, _, _, _, _) -> array_get(x, i) } }
fn s_set_trail(s, i, v) { match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> Sat(f0, f1, f2, f3, f4, f5, array_set(f6, i, v), f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) } }
fn s_lim(s, i) { match s { Sat(_, _, _, _, _, _, _, x, _, _, _, _, _, _, _, _, _) -> array_get(x, i) } }
fn s_set_lim(s, i, v) { match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> Sat(f0, f1, f2, f3, f4, f5, f6, array_set(f7, i, v), f8, f9, f10, f11, f12, f13, f14, f15, f16) } }
fn s_lit(s, i) { match s { Sat(_, _, _, _, _, _, _, _, x, _, _, _, _, _, _, _, _) -> array_get(x, i) } }
fn s_set_lit(s, i, v) { match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> Sat(f0, f1, f2, f3, f4, f5, f6, f7, array_set(f8, i, v), f9, f10, f11, f12, f13, f14, f15, f16) } }
fn s_start(s, i) { match s { Sat(_, _, _, _, _, _, _, _, _, x, _, _, _, _, _, _, _) -> array_get(x, i) } }
fn s_set_start(s, i, v) { match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, array_set(f9, i, v), f10, f11, f12, f13, f14, f15, f16) } }
fn s_heap(s, i) { match s { Sat(_, _, _, _, _, _, _, _, _, _, _, _, x, _, _, _, _) -> array_get(x, i) } }
fn s_set_heap(s, i, v) { match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, array_set(f12, i, v), f13, f14, f15, f16) } }
fn s_pos(s, i) { match s { Sat(_, _, _, _, _, _, _, _, _, _, _, _, _, x, _, _, _) -> array_get(x, i) } }
fn s_set_pos(s, i, v) { match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, array_set(f13, i, v), f14, f15, f16) } }
fn s_int(s, i) { match s { Sat(_, _, _, _, _, _, _, _, _, _, _, _, _, _, x, _, _) -> array_get(x, i) } }
fn s_set_int(s, i, v) { match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, array_set(f14, i, v), f15, f16) } }
fn s_inc(s) { match s { Sat(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, x, _) -> x } }
fn s_set_inc(s, v) { match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, v, f16) } }
fn s_lit_val(s, l) { let x = s_val(s, l / 2); if l % 2 == 1 { 0 - x } else { x } }
fn s_db_len(s) { match s { Sat(_, _, _, _, _, _, _, _, _, x, _, _, _, _, _, _, _) -> array_length(x) - 1 } }
fn s_cstart(s, ci) { s_start(s, ci) }
fn s_clen(s, ci) { s_start(s, ci + 1) - s_start(s, ci) }
// Appends a clause to the database: its literals go to the end of the arena.
fn s_push_clause(s, cl) {
  match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> {
    fn go(a, k) { if k >= array_length(cl) { a } else { go(array_push(a, array_get(cl, k)), k + 1) } }
    let a = go(f8, 0);
    let n = array_length(a);
    Sat(f0, f1, f2, f3, f4, f5, f6, f7, a, array_push(f9, n), f10, f11, f12, f13, f14, f15, f16)
  } }
}
fn s_push_proof(s, x) { match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, [x, ..f16]) } }
fn s_proof(s) { match s { Sat(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, x) -> reverse(x) } }
fn s_take_watch(s, w) {
  match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> { let list = array_get(f10, w); (list, array_get(f11, w), Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, array_set(f10, w, array_empty()), f11, f12, f13, f14, f15, f16)) } }
}
fn s_put_watch(s, w, list, len) { match s { Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) -> Sat(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, array_set(f10, w, list), array_set(f11, w, len), f12, f13, f14, f15, f16) } }
// Appends to a list with its length kept separately (the array may be longer).
fn push_at(list, len, x) { if len < array_length(list) { array_set(list, len, x) } else { array_push(list, x) } }
fn s_watch_push(s, w, x) { let (list, len, s) = s_take_watch(s, w); s_put_watch(s, w, push_at(list, len, x), len + 1) }

// --------------------------------------------------------------- the heap
fn s_less(s, a, b) { f_gt(s_act(s, a), s_act(s, b)) }
fn s_up_go(s, i, v) {
  if i > 0 {
    let p = (i - 1) / 2;
    if s_less(s, v, s_heap(s, p)) { let hp = s_heap(s, p); s_up_go(s_set_pos(s_set_heap(s, i, hp), hp, i), p, v) } else { (s, i) }
  } else { (s, i) }
}
fn s_up(s, i0) {
  let v = s_heap(s, i0);
  let (s, i) = s_up_go(s, i0, v);
  s_set_pos(s_set_heap(s, i, v), v, i)
}
fn s_down_go(s, i, v, hlen) {
  let c = 2 * i + 1;
  if c >= hlen { (s, i) }
  else {
    let c2 = if c + 1 < hlen && s_less(s, s_heap(s, c + 1), s_heap(s, c)) { c + 1 } else { c };
    if !s_less(s, s_heap(s, c2), v) { (s, i) } else { let hc = s_heap(s, c2); s_down_go(s_set_pos(s_set_heap(s, i, hc), hc, i), c2, v, hlen) }
  }
}
fn s_down(s, i0) {
  let v = s_heap(s, i0);
  let (s, i) = s_down_go(s, i0, v, s_int(s, 3));
  s_set_pos(s_set_heap(s, i, v), v, i)
}
fn s_insert(s, v) {
  if s_pos(s, v) >= 0 { s } else {
    let hlen = s_int(s, 3);
    let s = s_set_int(s_set_heap(s_set_pos(s, v, hlen), hlen, v), 3, hlen + 1);
    s_up(s, hlen)
  }
}
fn s_pop_max(s) {
  let v = s_heap(s, 0);
  let hlen = s_int(s, 3) - 1;
  let last = s_heap(s, hlen);
  let s = s_set_pos(s_set_int(s, 3, hlen), v, 0 - 1);
  if hlen > 0 { (v, s_down(s_set_pos(s_set_heap(s, 0, last), last, 0), 0)) } else { (v, s) }
}
fn s_bump(s, v) {
  let a = f_add(s_act(s, v), s_inc(s));
  let s = s_set_act(s, v, a);
  let s = if f_gt(a, f_1e100()) {
    let n = s_int(s, 4);
    let s = fold(range(1, n + 1), s, |s, i| s_set_act(s, i, f_mul(s_act(s, i), f_1em100())));
    s_set_inc(s, f_mul(s_inc(s), f_1em100()))
  } else { s };
  if s_pos(s, v) >= 0 { s_up(s, s_pos(s, v)) } else { s }
}

fn s_assign(s, l, from) {
  let v = l / 2;
  let tl = s_int(s, 0);
  let s = s_set_val(s, v, if l % 2 == 1 { 0 - 1 } else { 1 });
  let s = s_set_level(s, v, s_int(s, 2));
  let s = s_set_reason(s, v, from);
  s_set_int(s_set_trail(s, tl, l), 0, tl + 1)
}

fn s_add_clause(s, lits) {
  let idx = s_db_len(s);
  let s = s_push_clause(s, lits);
  if array_length(lits) >= 2 { (idx, s_watch_push(s_watch_push(s, lit_flip(array_get(lits, 0)), idx), lit_flip(array_get(lits, 1)), idx)) } else { (idx, s) }
}

// Unit propagation; returns a conflicting clause index or -1.
fn s_find_k(s, base, k, n) { if k >= n { 0 - 1 } else if s_lit_val(s, s_lit(s, base + k)) != 0 - 1 { k } else { s_find_k(s, base, k + 1, n) } }
fn s_copy_rest(ws, i, j, len) { if i >= len { (ws, j) } else { s_copy_rest(array_set(ws, j, array_get(ws, i)), i + 1, j + 1, len) } }
// Visits ws[i..len), keeping ws[0..j).
fn s_visit(s, ws, i, j, len, falsified) {
  if i >= len { (0 - 1, s, ws, j) }
  else {
    let ci = array_get(ws, i);
    let base = s_cstart(s, ci);
    let n = s_clen(s, ci);
    let s = if s_lit(s, base) == falsified { let l1 = s_lit(s, base + 1); s_set_lit(s_set_lit(s, base, l1), base + 1, falsified) } else { s };
    let first = s_lit(s, base);
    if s_lit_val(s, first) == 1 { s_visit(s, array_set(ws, j, ci), i + 1, j + 1, len, falsified) }
    else {
      let k = s_find_k(s, base, 2, n);
      if k >= 0 {
        let x = s_lit(s, base + k);
        let s = s_set_lit(s_set_lit(s, base + 1, x), base + k, falsified);
        s_visit(s_watch_push(s, lit_flip(x), ci), ws, i + 1, j, len, falsified)
      } else {
        let ws = array_set(ws, j, ci);
        if s_lit_val(s, first) == 0 - 1 {
          let (ws, j2) = s_copy_rest(ws, i + 1, j + 1, len);
          (ci, s, ws, j2)
        } else { s_visit(s_assign(s, first, ci), ws, i + 1, j + 1, len, falsified) }
      }
    }
  }
}
fn s_propagate(s) {
  let qhead = s_int(s, 1);
  if qhead >= s_int(s, 0) { (0 - 1, s) }
  else {
    let t = s_trail(s, qhead);
    let s = s_set_int(s, 1, qhead + 1);
    let (ws, len, s) = s_take_watch(s, t);
    let (confl, s, ws, j) = s_visit(s, ws, 0, 0, len, lit_flip(t));
    let s = s_put_watch(s, t, ws, j);
    if confl >= 0 { (confl, s) } else { s_propagate(s) }
  }
}

fn s_backtrack(s, lvl) {
  if s_int(s, 2) <= lvl { s } else {
    let stop = s_lim(s, lvl);
    fn go(s, i) {
      if i < stop { s } else {
        let v = s_trail(s, i) / 2;
        let s = s_set_phase(s, v, s_val(s, v));
        let s = s_set_reason(s_set_val(s, v, 0), v, 0 - 1);
        go(s_insert(s, v), i - 1)
      }
    }
    let s = go(s, s_int(s, 0) - 1);
    s_set_int(s_set_int(s_set_int(s, 0, stop), 1, stop), 2, lvl)
  }
}

fn s_index_in(s, base, n, x, k) { if k >= n { 0 - 1 } else if s_lit(s, base + k) == x { k } else { s_index_in(s, base, n, x, k + 1) } }

// First-UIP conflict analysis: (learned clause, backtrack level).
// Marks the literals of clause c from k on: (s, path count, learned literals).
fn s_an_lits(s, base, k, n, pc, ln, cur) {
  if k >= n { (s, pc, ln) } else {
    let q = s_lit(s, base + k);
    let v = q / 2;
    if s_seen(s, v) != 0 || s_level(s, v) == 0 { s_an_lits(s, base, k + 1, n, pc, ln, cur) }
    else {
      let s = s_bump(s_set_seen(s, v, 1), v);
      if s_level(s, v) == cur { s_an_lits(s, base, k + 1, n, pc + 1, ln, cur) } else { s_an_lits(s, base, k + 1, n, pc, array_push(ln, q), cur) }
    }
  }
}
fn s_back(s, idx) { if s_seen(s, s_trail(s, idx) / 2) == 0 { s_back(s, idx - 1) } else { idx } }
fn s_an_walk(s, confl, p, idx, path_c, learnt, cur) {
  let start = if p == 0 - 1 { 0 } else { 1 };
  let (s, path_c, learnt) = s_an_lits(s, s_cstart(s, confl), start, s_clen(s, confl), path_c, learnt, cur);
  let idx2 = s_back(s, idx);
  let p2 = s_trail(s, idx2);
  let confl2 = s_reason(s, p2 / 2);
  let s = s_set_seen(s, p2 / 2, 0);
  let pc = path_c - 1;
  if pc == 0 { (s, p2, learnt) }
  else {
    let b2 = s_cstart(s, confl2);
    let s = if s_lit(s, b2) != p2 { let k = s_index_in(s, b2, s_clen(s, confl2), p2, 0); let l0 = s_lit(s, b2); s_set_lit(s_set_lit(s, b2 + k, l0), b2, p2) } else { s };
    s_an_walk(s, confl2, p2, idx2 - 1, pc, learnt, cur)
  }
}
// The deepest level among learnt[1..] and where it is: (level, index).
fn s_an_max(s, learnt, k, bt, mx) {
  if k >= array_length(learnt) { (bt, mx) } else {
    let l = s_level(s, array_get(learnt, k) / 2);
    if l > bt { s_an_max(s, learnt, k + 1, l, k) } else { s_an_max(s, learnt, k + 1, bt, mx) }
  }
}
fn s_an_unsee(s, learnt, k) { if k >= array_length(learnt) { s } else { s_an_unsee(s_set_seen(s, array_get(learnt, k) / 2, 0), learnt, k + 1) } }
fn s_analyze(s, confl0) {
  let cur = s_int(s, 2);
  let (s, p, learnt0) = s_an_walk(s, confl0, 0 - 1, s_int(s, 0) - 1, 0, array_push(array_empty(), 0), cur);
  let learnt1 = array_set(learnt0, 0, lit_flip(p));
  let (bt, mx) = s_an_max(s, learnt1, 1, 0, 1);
  let learnt = if array_length(learnt1) > 1 { let t = array_get(learnt1, 1); array_set(array_set(learnt1, 1, array_get(learnt1, mx)), mx, t) } else { learnt1 };
  let s = s_an_unsee(s, learnt, 0);
  (learnt, bt, s_set_inc(s, f_mul(s_inc(s), f_inv095())))
}

// The Luby sequence 1 1 2 1 1 2 4 ..., which scales the restart intervals.
fn luby(i) {
  fn go(k) {
    let p = pow2_small(k);
    if i == p - 1 { pow2_small(k - 1) } else if i < p - 1 { luby(i - pow2_small(k - 1) + 1) } else { go(k + 1) }
  }
  go(1)
}

fn mem_int(xs, x) { match xs { [] -> false, [y, ..rest] -> if y == x { true } else { mem_int(rest, x) } } }
fn uniq_ints(xs) {
  fn go(xs, acc) { match xs { [] -> reverse(acc), [x, ..rest] -> if mem_int(acc, x) { go(rest, acc) } else { go(rest, [x, ..acc]) } } }
  go(xs, [])
}
// Does the clause hold a literal and its negation? (Internal literals.)
fn has_flip_pair(all_lits, xs) { match xs { [] -> false, [l, ..rest] -> if mem_int(all_lits, lit_flip(l)) { true } else { has_flip_pair(all_lits, rest) } } }

fn sat_solve(nvars, clauses, max_conflicts, mutant) {
  if mutant == "sat-claims-unsat" { SUnsat([[]]) } else {
    let n = nvars;
    let s0 = Sat(array_make(n + 1, 0), array_make(n + 1, 0), array_make(n + 1, 0 - 1), array_make(n + 1, 0 - 1), array_make(n + 1, f_zero()),
      array_make(n + 1, 0), array_make(n + 1, 0), array_make(n + 1, 0), array_empty(), array_make(1, 0), array_make(2 * n + 2, array_empty()), array_make(2 * n + 2, 0),
      array_make(n + 1, 0), array_make(n + 1, 0 - 1), array_from_list([0, 0, 0, 0, n]), f_one(), []);
    let s = fold(range(1, n + 1), s0, |s, v| s_insert(s, v));
    // Load the formula; units are assigned at level 0. (None: already unsatisfiable.)
    let loaded = fold(clauses, Some(s), |acc, c| match acc {
      None -> None,
      Some(s) -> {
        let lits = uniq_ints(map(c, lit_enc));
        if has_flip_pair(lits, lits) { Some(s) }
        else if is_empty(lits) { None }
        else if length(lits) == 1 {
          let l = list_get(lits, 0);
          let lv = s_lit_val(s, l);
          if lv == 0 - 1 { None } else if lv == 0 { let (idx, s) = s_add_clause(s, array_from_list(lits)); Some(s_assign(s, l, idx)) } else { Some(s) }
        } else { let (_, s) = s_add_clause(s, array_from_list(lits)); Some(s) }
      },
    });
    match loaded {
      None -> SUnsat([[]]),
      Some(s) -> {
        let (confl, s) = s_propagate(s);
        if confl >= 0 { SUnsat([[]]) } else { sat_search(s, 0, 0, 100 * luby(1), max_conflicts) }
      },
    }
  }
}

fn sat_search(s, conflicts, restarts, budget, max_conflicts) {
  let (confl, s) = s_propagate(s);
  if confl >= 0 {
    let conflicts = conflicts + 1;
    if s_int(s, 2) == 0 { SUnsat(s_proof(s_push_proof(s, []))) }
    else {
      let (learnt, bt, s) = s_analyze(s, confl);
      let s = s_push_proof(s, map(array_to_list(learnt), lit_dec));
      let s = s_backtrack(s, bt);
      let s = if array_length(learnt) == 1 { s_assign(s, array_get(learnt, 0), 0 - 1) } else { let (idx, s) = s_add_clause(s, learnt); s_assign(s, array_get(learnt, 0), idx) };
      if conflicts >= max_conflicts { SUnknown }
      else if budget - 1 <= 0 { sat_search(s_backtrack(s, 0), conflicts, restarts + 1, 100 * luby(restarts + 2), max_conflicts) }
      else { sat_search(s, conflicts, restarts, budget - 1, max_conflicts) }
    }
  } else {
    fn pick(s) {
      if s_int(s, 3) == 0 { (0, s) } else { let (w, s) = s_pop_max(s); if s_val(s, w) == 0 { (w, s) } else { pick(s) } }
    }
    let (v, s) = pick(s);
    if v == 0 {
      let n = s_int(s, 4);
      SSat(array_from_list(map(range(0, n + 1), |i| if i >= 1 && s_val(s, i) == 1 { 1 } else { 0 })))
    } else {
      let nl = s_int(s, 2);
      let s = s_set_int(s_set_lim(s, nl, s_int(s, 0)), 2, nl + 1);
      sat_search(s_assign(s, if s_phase(s, v) == 1 { 2 * v } else { 2 * v + 1 }, 0 - 1), conflicts, restarts, budget, max_conflicts)
    }
  }
}
