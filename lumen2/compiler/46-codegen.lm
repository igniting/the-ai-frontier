// ========================================================= code generation
// Reference-counted IR -> WebAssembly (codegen.js): the same runtime, value
// representation and per-type functions as the reference, made in the same
// order, so the modules are byte for byte the same.
//
// Values: Int is an i64; Bool, () and constructors without fields are i32
// immediates (below 1024); everything else is an i32 pointer to a heap object
// with a reference count at offset 0 and a tag at 4, fields in 8-byte slots
// from 8. Strings hold their length at 4 and bytes from 8; arrays their
// length at 4, capacity at 8 and elements from 16; closures the table index
// of their code at 4, of the function releasing their captures at 8, and the
// captures from 16.

fn k_overflow() { 1 }
fn k_divzero() { 2 }
fn k_bounds() { 3 }
fn k_oom() { 4 }
fn k_strlong() { 5 }
fn k_uaf() { 6 }
fn k_imm() { 1024 }
fn k_free_lists() { 64 }
fn k_scratch() { 256 }
fn k_data() { 1024 }
fn k_max_len() { 16777215 }
fn k_max_pages() { 16384 }

// The module under construction: functions (newest first), names of the
// per-type functions made, static data, string and closure addresses, the
// function table (newest first), its index and size.
type CG { CG(List<WFn>, Map<Bool>, Array<Int>, Map<Int>, Map<Int>, List<String>, Map<Int>, Int) }
// What code generation reads: adts, user Ord impls by type key, the mutant, paranoid, no inlining.
type GX { GX(OMap<AdtInfo>, List<(String, String)>, String, Bool, Bool) }
fn gx_adts(gx) { match gx { GX(a, _, _, _, _) -> a } }
fn gx_mutant(gx) { match gx { GX(_, _, m, _, _) -> m } }
fn gx_paranoid(gx) { match gx { GX(_, _, _, p, _) -> p } }
fn gx_noinline(gx) { match gx { GX(_, _, _, _, n) -> n } }
fn gx_heap(gx, t) { is_heap(gx_adts(gx), t) }

fn cg_made(cg, n) { match cg { CG(_, made, _, _, _, _, _, _) -> m_has(made, n) } }
fn cg_mark(cg, n) { match cg { CG(f, made, d, s, c, t, ti, tn) -> CG(f, m_set(made, n, true), d, s, c, t, ti, tn) } }
fn cg_add(cg, f) { match cg { CG(fs, made, d, s, c, t, ti, tn) -> CG([f, ..fs], made, d, s, c, t, ti, tn) } }
fn cg_data_len(cg) { match cg { CG(_, _, d, _, _, _, _, _) -> array_length(d) } }
fn cg_push(cg, b) { match cg { CG(f, made, d, s, c, t, ti, tn) -> CG(f, made, array_push(d, b), s, c, t, ti, tn) } }
fn cg_push_i32(cg, v) {
  let u = ((v % 4294967296) + 4294967296) % 4294967296;
  cg_push(cg_push(cg_push(cg_push(cg, u % 256), (u / 256) % 256), (u / 65536) % 256), (u / 16777216) % 256)
}
fn cg_pad(cg) { if cg_data_len(cg) % 8 != 0 { cg_pad(cg_push(cg, 0)) } else { cg } }
fn cg_string(cg, s) {
  match cg { CG(_, _, _, strs, _, _, _, _) -> match m_get(strs, s) {
    Some(a) -> (a, cg),
    None -> {
      let cg = cg_pad(cg);
      let addr = k_data() + cg_data_len(cg);
      let cg = match cg { CG(f, made, d, st, c, t, ti, tn) -> CG(f, made, d, m_set(st, s, addr), c, t, ti, tn) };
      let cg = cg_push_i32(cg_push_i32(cg, 0 - 1), string_length(s));
      let cg = fold(range(0, string_length(s)), cg, |cg, i| cg_push(cg, char_code_at(s, i)));
      (addr, cg_pad(cg))
    },
  } }
}
fn cg_slot(cg, n) {
  match cg { CG(f, made, d, s, c, t, ti, tn) -> match m_get(ti, n) {
    Some(i) -> (i, cg),
    None -> (tn, CG(f, made, d, s, c, [n, ..t], m_set(ti, n, tn), tn + 1)),
  } }
}
fn cg_closure(cg, n) {
  match cg { CG(_, _, _, _, clos, _, _, _) -> match m_get(clos, n) {
    Some(a) -> (a, cg),
    None -> {
      let cg = cg_pad(cg);
      let addr = k_data() + cg_data_len(cg);
      let cg = match cg { CG(f, made, d, s, c, t, ti, tn) -> CG(f, made, d, s, m_set(c, n, addr), t, ti, tn) };
      let (slot, cg) = cg_slot(cg, n);
      (addr, cg_push_i32(cg_push_i32(cg_push_i32(cg_push_i32(cg, 0 - 1), slot), 0), 0))
    },
  } }
}
fn mkfn(cg, name, params, results, locals, body) { cg_add(cg, WFn(name, params, results, locals, code_flat(body))) }

fn wfail(code) { CL([wi32(code), wcall("rt_fail"), wop("unreachable")]) }
fn wtrap(code) { CL([wif(), wfail(code), wend()]) }
fn wload(t, off) { wmem(if valtype(t) == "i64" { "i64.load" } else { "i32.load" }, off) }
fn wstore(t, off) { wmem(if valtype(t) == "i64" { "i64.store" } else { "i32.store" }, off) }
fn wchk(gx) { if gx_paranoid(gx) { wcall("rt_chk") } else { wnone() } }
fn wlen(gx, p) { CL([wget(p), wchk(gx), wmem("i32.load", 4)]) }
fn wslot(a, i) { CL([wget(a), wget(i), wi32(3), wop("i32.shl"), wop("i32.add")]) }
fn whead(c) { CL([wget(c), wi32(2), wop("i32.shl")]) }
fn is_int_ty(t) { match t { TC("Int", _) -> true, _ -> false } }
fn variants_of(gx, t) {
  match t {
    TC(n, args) -> match om_get(gx_adts(gx), n) {
      Some(d) -> { let sub = zip(adt_params(d), args); map(adt_ctors(d), |c| (ctor_idx(c), map(ctor_fields(c), |f| subst_params(f, sub)))) },
      None -> internal("codegen: variants of " ++ tkey(t)),
    },
    _ -> internal("codegen: variants of " ++ tkey(t)),
  }
}
fn with_fields(vs) { filter(vs, |v| match v { (_, fs) -> !is_empty(fs) }) }

// ---------------------------------------------------------------- runtime
fn i32p(n) { (n, "i32") }
fn i64p(n) { (n, "i64") }
fn bin_i64(cg, name, body) { mkfn(cg, name, [i64p("a"), i64p("b")], ["i64"], [i64p("r")], body) }

fn runtime(gx, cg) {
  let cg = rt_rt_fail(gx, cg);
  let cg = rt_rt_class(gx, cg);
  let cg = rt_rt_alloc(gx, cg);
  let cg = rt_rt_free(gx, cg);
  let cg = rt_rt_dup(gx, cg);
  let cg = rt_rt_release(gx, cg);
  let cg = rt_rt_chk(gx, cg);
  let cg = rt_rt_tag(gx, cg);
  let cg = rt_int_add(gx, cg);
  let cg = rt_int_sub(gx, cg);
  let cg = rt_int_mul(gx, cg);
  let cg = rt_int_div(gx, cg);
  let cg = rt_int_rem(gx, cg);
  let cg = rt_int_neg(gx, cg);
  let cg = rt_str_new(gx, cg);
  let cg = rt_str_concat(gx, cg);
  let cg = rt_str_concat_list(gx, cg);
  let cg = rt_str_cmp(gx, cg);
  let cg = rt_int_to_string(gx, cg);
  let cg = rt_str_length(gx, cg);
  let cg = rt_str_sub(gx, cg);
  let cg = rt_str_code_at(gx, cg);
  let cg = rt_str_from_code(gx, cg);
  let (newline, cg) = cg_string(cg, "\n");
  let cg = rt_str_print(gx, cg);
  let cg = rt_str_println(gx, cg, newline);
  let cg = rt_str_read_input(gx, cg);
  let cg = rt_str_read_line(gx, cg);
  let cg = rt_str_panic(gx, cg);
  let cg = rt_arr_new(gx, cg);
  rt_arr_length(gx, cg)
}

fn rt_rt_fail(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  mkfn(cg, "rt_fail", [i32p("code")], [], [], CL([wget("code"), wcall("host_fail"), wop("unreachable")]))
}
  // Size class of an allocation: log2 of the block size, at least 16 bytes.
fn rt_rt_class(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  mkfn(cg, "rt_class", [i32p("size")], ["i32"], [], CL([
    wget("size"), wi32(16), wop("i32.le_u"), wif_r("i32"), wi32(4),
    wop("else"), wi32(32), wget("size"), wi32(1), wop("i32.sub"), wop("i32.clz"), wop("i32.sub"), wend(),
  ]))
}
fn rt_rt_alloc(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  mkfn(cg, "rt_alloc", [i32p("size")], ["i32"], [i32p("c"), i32p("p"), i32p("top")], CL([
    wget("size"), wcall("rt_class"), wset("c"),
    wblock("have"),
    if paranoid { wnone() } else { CL([
      whead("c"), wmem("i32.load", k_free_lists()), wtee("p"), wif(),
      whead("c"), wget("p"), wmem("i32.load", 8), wmem("i32.store", k_free_lists()), wbr("have"), wend(),
    ]) },
    wgget("hp"), wset("p"),
    wgget("hp"), wi32(1), wget("c"), wop("i32.shl"), wop("i32.add"), wgset("hp"),
    wop("memory.size"), wi32(16), wop("i32.shl"), wset("top"),
    wgget("hp"), wget("top"), wop("i32.gt_u"), wif(),
    wgget("hp"), wget("top"), wop("i32.sub"), wi32(65535), wop("i32.add"), wi32(16), wop("i32.shr_u"),
    wop("memory.grow"), wi32(0 - 1), wop("i32.eq"), wif(), wfail(k_oom()), wend(), wend(),
    wend(),
    wget("p"), wi32(1), wmem("i32.store", 0),
    wgget("live"), wi32(1), wop("i32.add"), wgset("live"),
    wgget("allocs"), wi32(1), wop("i32.add"), wgset("allocs"),
    wget("p"),
  ]))
}
fn rt_rt_free(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  mkfn(cg, "rt_free", [i32p("p"), i32p("size")], [], [i32p("c")], CL([
    wget("p"), wi32(0), wmem("i32.store", 0),
    wgget("live"), wi32(1), wop("i32.sub"), wgset("live"),
    if paranoid { wnone() } else { CL([
      wget("size"), wcall("rt_class"), wset("c"),
      wget("p"), whead("c"), wmem("i32.load", k_free_lists()), wmem("i32.store", 8),
      whead("c"), wget("p"), wmem("i32.store", k_free_lists()),
    ]) },
  ]))
}
  // dup: one more reference. Immediates and static objects are not counted.
fn rt_rt_dup(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  mkfn(cg, "rt_dup", [i32p("p")], ["i32"], [i32p("rc")], CL([
    wget("p"), wi32(k_imm()), wop("i32.ge_u"), wif(),
    wget("p"), wmem("i32.load", 0), wtee("rc"), wi32(0), wop("i32.gt_s"), wif(),
    wget("p"), wget("rc"), wi32(1), wop("i32.add"), wmem("i32.store", 0),
    wop("else"), wget("rc"), wop("i32.eqz"), wif(), wfail(k_uaf()), wend(), wend(),
    wend(), wget("p"),
  ]))
}
  // One reference fewer; 1 when that was the last one and the object must be freed.
fn rt_rt_release(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  mkfn(cg, "rt_release", [i32p("p")], ["i32"], [i32p("rc")], CL([
    wget("p"), wi32(k_imm()), wop("i32.lt_u"), wif(), wi32(0), wop("return"), wend(),
    wget("p"), wmem("i32.load", 0), wtee("rc"), wi32(1), wop("i32.gt_s"), wif(),
    wget("p"), wget("rc"), wi32(1), wop("i32.sub"), wmem("i32.store", 0), wi32(0), wop("return"), wend(),
    wget("rc"), wi32(1), wop("i32.eq"), wif(), wi32(1), wop("return"), wend(),
    wget("rc"), wop("i32.eqz"), wif(), wfail(k_uaf()), wend(),
    wi32(0),
  ]))
}
  // Paranoid mode: every read through a pointer checks that the object is live.
fn rt_rt_chk(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  mkfn(cg, "rt_chk", [i32p("p")], ["i32"], [], CL([
    wget("p"), wi32(k_imm()), wop("i32.ge_u"), wif(), wget("p"), wmem("i32.load", 0), wop("i32.eqz"), wif(), wfail(k_uaf()), wend(), wend(), wget("p"),
  ]))
}
fn rt_rt_tag(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  mkfn(cg, "rt_tag", [i32p("p")], ["i32"], [], CL([
    wget("p"), wi32(k_imm()), wop("i32.lt_u"), wif_r("i32"), wget("p"), wop("else"), wget("p"), chk, wmem("i32.load", 4), wend(),
  ]))
}
  // Checked 64-bit arithmetic.
fn rt_int_add(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  bin_i64(cg, "int_add", CL([
    wget("a"), wget("b"), wop("i64.add"), wset("r"),
    if mutant == "add-no-overflow" { wnone() } else { CL([wget("a"), wget("r"), wop("i64.xor"), wget("b"), wget("r"), wop("i64.xor"), wop("i64.and"), wi64(0), wop("i64.lt_s"), wif(), wfail(k_overflow()), wend()]) },
    wget("r"),
  ]))
}
fn rt_int_sub(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  bin_i64(cg, "int_sub", CL([
    wget("a"), wget("b"), wop("i64.sub"), wset("r"),
    wget("a"), wget("b"), wop("i64.xor"), wget("a"), wget("r"), wop("i64.xor"), wop("i64.and"), wi64(0), wop("i64.lt_s"), wif(), wfail(k_overflow()), wend(),
    wget("r"),
  ]))
}
fn rt_int_mul(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  bin_i64(cg, "int_mul", CL([
    wget("a"), wop("i64.eqz"), wget("b"), wop("i64.eqz"), wop("i32.or"), wif(), wi64(0), wop("return"), wend(),
    wget("a"), wi64(0 - 1), wop("i64.eq"), wget("b"), wi64(int_min()), wop("i64.eq"), wop("i32.and"),
    wget("b"), wi64(0 - 1), wop("i64.eq"), wget("a"), wi64(int_min()), wop("i64.eq"), wop("i32.and"), wop("i32.or"), wif(), wfail(k_overflow()), wend(),
    wget("a"), wget("b"), wop("i64.mul"), wtee("r"), wget("b"), wop("i64.div_s"), wget("a"), wop("i64.ne"), wif(), wfail(k_overflow()), wend(),
    wget("r"),
  ]))
}
fn rt_int_div(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  bin_i64(cg, "int_div", CL([
    wget("b"), wop("i64.eqz"), wif(), wfail(k_divzero()), wend(),
    wget("a"), wi64(int_min()), wop("i64.eq"), wget("b"), wi64(0 - 1), wop("i64.eq"), wop("i32.and"), wif(), wfail(k_overflow()), wend(),
    wget("a"), wget("b"), wop("i64.div_s"),
  ]))
}
fn rt_int_rem(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  bin_i64(cg, "int_rem", CL([
    wget("b"), wop("i64.eqz"), wif(), wfail(k_divzero()), wend(),
    wget("a"), wget("b"), wop("i64.rem_s"),
  ]))
}
fn rt_int_neg(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  mkfn(cg, "int_neg", [i64p("a")], ["i64"], [], CL([
    wget("a"), wi64(int_min()), wop("i64.eq"), wif(), wfail(k_overflow()), wend(), wi64(0), wget("a"), wop("i64.sub"),
  ]))
}
  // Strings.
fn rt_str_new(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  mkfn(cg, "str_new", [i32p("n")], ["i32"], [i32p("p")], CL([
    wget("n"), wi32(k_max_len()), wop("i32.gt_u"), wif(), wfail(k_strlong()), wend(),
    wget("n"), wi32(8), wop("i32.add"), wcall("rt_alloc"), wtee("p"), wget("n"), wmem("i32.store", 4), wget("p"),
  ]))
}
fn rt_str_concat(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  mkfn(cg, "str_concat", [i32p("a"), i32p("b")], ["i32"], [i32p("la"), i32p("lb"), i32p("p")], CL([
    wlen(gx, "a"), wset("la"), wlen(gx, "b"), wset("lb"),
    wget("la"), wget("lb"), wop("i32.add"), wcall("str_new"), wset("p"),
    wget("p"), wi32(8), wop("i32.add"), wget("a"), wi32(8), wop("i32.add"), wget("la"), wop("memory.copy"),
    wget("p"), wi32(8), wop("i32.add"), wget("la"), wop("i32.add"), wget("b"), wi32(8), wop("i32.add"), wget("lb"), wop("memory.copy"),
    wget("p"),
  ]))
}
  // Joins a List<String> (Cons cells: head at 8, tail at 16; Nil is the immediate 0).
fn rt_str_concat_list(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  mkfn(cg, "str_concat_list", [i32p("xs")], ["i32"], [i32p("c"), i64p("n"), i32p("p"), i32p("at"), i32p("s")], CL([
    wget("xs"), wset("c"),
    wblock("sized"), wloop("size"),
    wget("c"), wi32(k_imm()), wop("i32.lt_u"), wbr_if("sized"),
    wget("n"), wget("c"), chk, wmem("i32.load", 8), wmem("i32.load", 4), wop("i64.extend_i32_u"), wop("i64.add"), wset("n"),
    wget("c"), wmem("i32.load", 16), wset("c"), wbr("size"), wend(), wend(),
    wget("n"), wi64(k_max_len()), wop("i64.gt_u"), wif(), wfail(k_strlong()), wend(),
    wget("n"), wop("i32.wrap_i64"), wcall("str_new"), wtee("p"), wi32(8), wop("i32.add"), wset("at"),
    wget("xs"), wset("c"),
    wblock("done"), wloop("copy"),
    wget("c"), wi32(k_imm()), wop("i32.lt_u"), wbr_if("done"),
    wget("c"), wmem("i32.load", 8), wset("s"),
    wget("at"), wget("s"), wi32(8), wop("i32.add"), wget("s"), wmem("i32.load", 4), wop("memory.copy"),
    wget("at"), wget("s"), wmem("i32.load", 4), wop("i32.add"), wset("at"),
    wget("c"), wmem("i32.load", 16), wset("c"), wbr("copy"), wend(), wend(),
    wget("p"),
  ]))
}
fn rt_str_cmp(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  mkfn(cg, "str_cmp", [i32p("a"), i32p("b")], ["i32"], [i32p("la"), i32p("lb"), i32p("n"), i32p("i"), i32p("ca"), i32p("cb")], CL([
    wlen(gx, "a"), wset("la"), wlen(gx, "b"), wset("lb"),
    wget("la"), wget("lb"), wget("la"), wget("lb"), wop("i32.lt_u"), wop("select"), wset("n"),
    wblock("done"), wloop("next"),
    wget("i"), wget("n"), wop("i32.ge_u"), wbr_if("done"),
    wget("a"), wget("i"), wop("i32.add"), wmem("i32.load8_u", 8), wset("ca"),
    wget("b"), wget("i"), wop("i32.add"), wmem("i32.load8_u", 8), wset("cb"),
    wget("ca"), wget("cb"), wop("i32.ne"), wif(), wi32(0 - 1), wi32(1), wget("ca"), wget("cb"), wop("i32.lt_u"), wop("select"), wop("return"), wend(),
    wget("i"), wi32(1), wop("i32.add"), wset("i"), wbr("next"),
    wend(), wend(),
    wget("la"), wget("lb"), wop("i32.gt_u"), wget("la"), wget("lb"), wop("i32.lt_u"), wop("i32.sub"),
  ]))
}
fn rt_int_to_string(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  mkfn(cg, "int_to_string", [i64p("n")], ["i32"], [i32p("neg"), i32p("i"), i32p("p")], CL([
    wi32(k_scratch() + 32), wset("i"),
    wget("n"), wi64(0), wop("i64.lt_s"), wset("neg"),
    wget("neg"), wop("i32.eqz"), wif(), wi64(0), wget("n"), wop("i64.sub"), wset("n"), wend(),
    // n <= 0 from here on, so the most negative Int needs no special case.
    wloop("digit"),
    wget("i"), wi32(1), wop("i32.sub"), wset("i"),
    wget("i"), wi64(0), wget("n"), wi64(10), wop("i64.rem_s"), wop("i64.sub"), wop("i32.wrap_i64"), wi32(48), wop("i32.add"), wmem("i32.store8", 0),
    wget("n"), wi64(10), wop("i64.div_s"), wtee("n"), wop("i64.eqz"), wop("i32.eqz"), wbr_if("digit"),
    wend(),
    wget("neg"), wif(), wget("i"), wi32(1), wop("i32.sub"), wtee("i"), wi32(45), wmem("i32.store8", 0), wend(),
    wi32(k_scratch() + 32), wget("i"), wop("i32.sub"), wcall("str_new"), wset("p"),
    wget("p"), wi32(8), wop("i32.add"), wget("i"), wi32(k_scratch() + 32), wget("i"), wop("i32.sub"), wop("memory.copy"),
    wget("p"),
  ]))
}
fn rt_str_length(gx, cg) {
  let paranoid = gx_paranoid(gx);
  let mutant = gx_mutant(gx);
  let chk = wchk(gx);
  mkfn(cg, "str_length", [i32p("s")], ["i64"], [], CL([wlen(gx, "s"), wop("i64.extend_i32_u")]))
}
